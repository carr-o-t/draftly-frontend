# url of the go backend for the /api/* proxy routes.
# server only, never reaches the browser. include the /v1 prefix.
# prod example: https://api.draftly.byethecarrot.dev/v1
API_BASE_URL=http://localhost:8080/v1

# websocket url of the go backend, used for live editing in the browser.
# this one IS public. use wss:// in production because the page is https.
# prod example: wss://api.draftly.byethecarrot.dev/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
